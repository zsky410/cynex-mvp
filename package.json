{
	"name": "cynex-mvp",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.24.0",
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"build": "react-router build",
		"build:production": "CLOUDFLARE_ENV=production react-router build",
		"build:staging": "CLOUDFLARE_ENV=staging react-router build",
		"db:reset": "supabase db reset",
		"db:test": "supabase test db",
		"db:types": "supabase gen types typescript --local > app/types/database.ts",
		"dev": "react-router dev",
		"lint": "eslint .",
		"test": "vitest run --passWithNoTests",
		"test:auth": "node scripts/test-auth.mjs",
		"test:categories": "node scripts/test-category-crud.mjs",
		"test:staging-roles": "node scripts/test-staging-catalog-roles.mjs",
		"test:db": "supabase test db",
		"test:e2e": "playwright test",
		"typecheck": "wrangler types && react-router typegen && tsc -b",
		"deploy:staging": "pnpm run build:staging && wrangler deploy --env staging",
		"deploy:production": "pnpm run build:production && wrangler deploy --env production",
		"preview": "pnpm run build && vite preview",
		"cf-typegen": "wrangler types",
		"postinstall": "wrangler types"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.116.0",
		"isbot": "^5.1.36",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "^8"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.8",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@react-router/dev": "^8",
		"@tailwindcss/vite": "^4.2.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^22",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"eslint": "^10.10.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.12.0",
		"jsdom": "^30.0.1",
		"supabase": "^2.117.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.0.3",
		"vitest": "^5.0.0",
		"wrangler": "^4.131.1"
	}
}
